{
    "manifest_version": 3,
    "name": "Workday: Better Autofill",
    "version": "2.1.0",
    "description": "Autofills job applications on Workday and Greenhouse, including experience, education, and legal disclosures.",
    "homepage_url": "https://github.com/N2pium/Workday-Better-Autofill-GCE",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "sidePanel",
        "identity",
        "alarms"
    ],
    "host_permissions": [
        "*://*.myworkdayjobs.com/*"
    ],
    "optional_host_permissions": [
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://*.icims.com/*",
        "*://*.paylocity.com/*",
        "https://cfswo4fym6.execute-api.us-east-2.amazonaws.com/*",
        "https://better-autofill.auth.us-east-2.amazoncognito.com/*",
        "https://easyapply-data-resumesb6263180-1qd2ewprnfb4.s3.us-east-2.amazonaws.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.myworkdayjobs.com/*"
            ],
            "js": [
                "adapters/workday-pack.js",
                "adapters/verify-pack.js",
                "content.js",
                "cloud-library.js",
                "ai-assist.js"
            ],
            "run_at": "document_end"
        }
    ]
}
